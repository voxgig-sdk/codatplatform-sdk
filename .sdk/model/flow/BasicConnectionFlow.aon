# BasicConnectionFlow

main: kit: flow: BasicConnectionFlow:
{
  entity: "connection",
  kind: "basic",
  name: "BasicConnectionFlow",
  step: [
    {
      input: {
        ref: "connection_ref01"
      }

      match: {
        company_id: "company01"
      }

      op: "create"
    }

    {
      match: {
        company_id: "company01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemExists",
          def: {
            ref: "connection_ref01"
          }
        }
      ]
    }

    {
      data: {
        company_id: "company01"
      }

      input: {
        ref: "connection_ref01",
        srcdatavar: "connection_ref01_data",
        suffix: "_up0",
        textfield: "created"
      }

      op: "update",
      spec: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-connection_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "connection_ref01",
        srcdatavar: "connection_ref01_data",
        suffix: "_dt0"
      }

      match: {
        company_id: "company01",
        id: "connection01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-connection_ref01"
          }
        }
      ]
    }

    {
      input: {
        ref: "connection_ref01",
        suffix: "_rm0"
      }

      match: {
        company_id: "company01",
        id: "connection01"
      }

      op: "remove"
    }

    {
      input: {
        suffix: "_rt0"
      }

      match: {
        company_id: "company01"
      }

      op: "list",
      valid: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "connection_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicConnectionFlow"
}