# BasicSettingFlow

main: kit: flow: BasicSettingFlow:
{
  entity: "setting",
  kind: "basic",
  name: "BasicSettingFlow",
  step: [
    {
      i: {
        ref: "setting_ref01"
      }

      o: "create"
    }

    {
      o: "list",
      v: [
        {
          apply: "ItemExists",
          def: {
            ref: "setting_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "setting_ref01",
        suffix: "_rm0"
      }

      m: {
        id: "setting01"
      }

      o: "remove"
    }

    {
      i: {
        suffix: "_rt0"
      }

      o: "list",
      v: [
        {
          apply: "ItemNotExists",
          def: {
            ref: "setting_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicSettingFlow"
}