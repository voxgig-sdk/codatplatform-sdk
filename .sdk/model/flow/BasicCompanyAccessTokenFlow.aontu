# BasicCompanyAccessTokenFlow

main: kit: flow: BasicCompanyAccessTokenFlow:
{
  entity: "company_access_token",
  kind: "basic",
  name: "BasicCompanyAccessTokenFlow",
  step: [
    {
      input: {
        ref: "company_access_token_ref01",
        srcdatavar: "company_access_token_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "company_access_token01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-company_access_token_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCompanyAccessTokenFlow"
}